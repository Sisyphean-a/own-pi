{
  "name": "pi-optimization",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pi optimizations for shell redirection, fullscreen interaction, silent updates, and delayed prompts",
  "keywords": [
    "pi-package",
    "pi-extension",
    "optimization",
    "nul-redirect",
    "fullscreen-scroll",
    "auto-update",
    "delayed-prompt",
    "scheduler"
  ],
  "files": [
    "extensions/",
    "src/"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.86.0",
    "@types/node": "^22.19.19",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  }
}
